<Project>
  <PropertyGroup>
    <FerriteIl2Cpp>$(MSBuildProjectName.Contains('Il2Cpp'))</FerriteIl2Cpp>
  </PropertyGroup>
  <PropertyGroup Condition="'$(FerriteIl2Cpp)' != 'True'">
    <GameDir Condition="'$(GameDir)' == ''">D:\Program Files (x86)\Steam\steamapps\common\Casualties Unknown</GameDir>
    <GameManaged Condition="'$(GameManaged)' == ''">$([System.IO.Directory]::GetDirectories('$(GameDir)', '*_Data')[0])\Managed</GameManaged>
    <TargetFramework>net472</TargetFramework>
  </PropertyGroup>
  <PropertyGroup Condition="'$(FerriteIl2Cpp)' == 'True'">
    <TargetFramework>net8.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <PropertyGroup>
    <LibsDir>$(MSBuildThisFileDirectory)libs</LibsDir>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>portable</DebugType>
    <PathMap>$(MSBuildThisFileDirectory)=ferrite/</PathMap>
  </PropertyGroup>
  <ItemGroup Condition="'$(FerriteIl2Cpp)' != 'True'">
    <Reference Include="UnityEngine"><HintPath>$(GameManaged)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(GameManaged)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(GameManaged)\UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.InputLegacyModule"><HintPath>$(GameManaged)\UnityEngine.InputLegacyModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(LibsDir)\0Harmony.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
